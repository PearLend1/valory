# Server configuration
NODE_ENV=development
PORT=3000

# Database (optional for a Street-Data-only public beta, but required for accounts and persistence)
DATABASE_URL=mysql://root:password@localhost:3306/valory

# Local demo identities. These are ignored in production.
ENABLE_DEMO_MODE=false
ENABLE_DEMO_ADMIN=false

# Public forms that collect names, emails or phone numbers must stay disabled
# until the accurate privacy notice, retention rules and processor terms are live.
ENABLE_PUBLIC_SIGNUPS=false

# Authentication and security
# Generate a long random value and store it only in the deployment secret manager.
JWT_SECRET=replace-with-a-long-random-production-secret

# OAuth configuration
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=owner-openid-123

# Application
VITE_APP_ID=valory-app-dev

# Street Data API
# Server-side secret. Never prefix this with VITE_ and never expose it to browser code.
STREET_DATA_API_KEY=replace-with-the-key-from-your-street-data-dashboard

# Synthetic/demo valuations must remain false in every public deployment.
# Set true only for local development or an explicitly labelled demonstration.
ALLOW_SYNTHETIC_VALUATIONS=false

# External API - Forge/LLM integration
BUILT_IN_FORGE_API_URL=https://api.forge.example.com
BUILT_IN_FORGE_API_KEY=forge-api-key-placeholder

# Analytics (optional)
# Do not load analytics until the visitor has consented to non-essential cookies.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
